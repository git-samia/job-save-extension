{
  "manifest_version": 3,
  "name": "Job Description Saver",
  "version": "1.0.0",
  "description": "Save job postings as PDF with one click. Keeps track of positions you've applied to.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "debugger"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.myworkdayjobs.com/*"],
      "js": ["content/workday-parser.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save-posting": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Save current job posting as PDF"
    }
  }
}
